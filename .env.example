# ─── OpenAI ───────────────────────────────────────────────
# platform.openai.com → API keys → create a project-scoped key
OPENAI_API_KEY=
# Model Ava thinks with. Swap to gpt-6.1-sol if luna fumbles bookings.
OPENAI_MODEL=gpt-6-luna

# ─── WhatsApp (Meta Cloud API) ────────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup
# Use a System User token (Business Settings → System users) so it doesn't expire after 24h
WHATSAPP_ACCESS_TOKEN=
# Numeric "Phone number ID" on the API Setup screen (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App → Settings → Basic → App Secret (used to verify webhook signatures; Edge Function only)
WHATSAPP_APP_SECRET=
# A random string you invent (openssl rand -hex 32); paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# Graph API version
WHATSAPP_GRAPH_VERSION=v23.0

# ─── Google Calendar (service account) ────────────────────
# console.cloud.google.com → IAM & Admin → Service Accounts → create → Keys → Add key → JSON.
# Claude fills these two from the downloaded JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# YOUR calendar ID (usually your Gmail address). Share that calendar with the service account email
# with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=
# One reusable Google Meet link (meet.google.com → New meeting → Create a meeting for later)
MEET_LINK=

# ─── Business rules ───────────────────────────────────────
BUSINESS_TIMEZONE=Africa/Nairobi
# Short label customers see after every time
BUSINESS_TZ_LABEL=EAT
BUSINESS_NAME="Northbeam Advisory"

# ─── Supabase ─────────────────────────────────────────────
# supabase.com → project → Project Settings → API
SUPABASE_URL=
# Secret: server-side only (Trigger.dev + Edge Function). Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Trigger.dev ──────────────────────────────────────────
# cloud.trigger.dev → project → API keys. Use the DEV key (tr_dev_...) while recording.
# Needed by the Edge Function (Supabase secret) and the dashboard to start tasks.
TRIGGER_SECRET_KEY=
